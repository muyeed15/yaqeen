# Yaqeen backend environment
#
# Backend public URL:  https://backend.example.com
# Frontend public URL: https://frontend.example.com

# Security
SECRET_KEY=django-insecure-changeme
DEBUG=True

# Host headers Django accepts. Put the BACKEND host here, without a scheme.
ALLOWED_HOSTS=backend.example.com,localhost,127.0.0.1

# Browser origins allowed to call this API. Put the FRONTEND origin here, with a scheme.
CORS_ALLOWED_ORIGINS=https://frontend.example.com

# Origins trusted for forms and the Django admin. Put the BACKEND origin here, with a scheme.
CSRF_TRUSTED_ORIGINS=https://backend.example.com

SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# Database
DB_NAME=yaqeen_db
DB_USER=postgres
DB_PASSWORD=your-password
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=60

# Tokens and bind address
ACCESS_TOKEN_MINUTES=1440
REFRESH_TOKEN_MINUTES=43200
DJANGO_PORT=8003
BACKEND_PORT=8003

# Address Gunicorn or the dev server binds to. Keep 127.0.0.1 when a proxy is in front.
BACKEND_HOST=127.0.0.1

# Business rules
TRANSFER_FEE_PERCENT=1.5
PAGE_SIZE=10
PAGE_SIZE_MAX=50
