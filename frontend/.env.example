# Yaqeen frontend environment
#
# Frontend public URL: https://frontend.example.com
# Backend public URL:  https://backend.example.com

# Address the Next.js server binds to. Keep 127.0.0.1 when a proxy is in front.
PORT=3003
HOST=127.0.0.1
USE_HTTPS=false

# Server-side URL of the Django API. Put the BACKEND here.
# Use http://127.0.0.1:8003 when the backend runs on the same host behind the proxy,
# otherwise use the public backend URL: https://backend.example.com
DJANGO_API_URL=http://127.0.0.1:8003

ACCESS_TOKEN_MINUTES=1440
REFRESH_TOKEN_MINUTES=43200
NEXT_PUBLIC_TOAST_DURATION_MS=6000
NEXT_PUBLIC_LOG_LEVEL=info
PAGE_SIZE=10
